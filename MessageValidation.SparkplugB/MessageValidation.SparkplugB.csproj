<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>MessageValidation.SparkplugB</PackageId>
    <Description>Eclipse Sparkplug B validator for the MessageValidation pipeline — parses spBv1.0 topics and Protocol Buffers payloads, enforces required fields per message type (NBIRTH, NDATA, NDEATH, DBIRTH…), checks metric values against declared DataTypes, and tracks seq (0-255 rollover) and bdSeq per edge node.</Description>
    <PackageTags>messaging;validation;message-validation;sparkplug;sparkplug-b;mqtt;iiot;industrial-iot;protobuf;iot;edge;scada;uns;dotnet;pipeline</PackageTags>
    <PackageReleaseNotes>https://github.com/Romain-OD/MessageValidation/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- Generated protobuf code has no XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MessageValidation\MessageValidation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\sparkplug_b.proto" GrpcServices="None" Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\MessageValidation-logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
