<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>MessageValidation.ImmediateValidations</PackageId>
    <Description>Immediate.Validations adapter for the MessageValidation pipeline — bridge source-generated, AOT-friendly, zero-reflection IValidationTarget&lt;T&gt; rules into IMessageValidator&lt;T&gt;.</Description>
    <PackageTags>messaging;validation;message-validation;immediate-validations;immediate;source-generator;aot;pipeline;dotnet;middleware;consumer;microservices</PackageTags>
    <PackageReleaseNotes>https://github.com/Romain-OD/MessageValidation/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MessageValidation\MessageValidation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Immediate.Validations" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\MessageValidation-logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
